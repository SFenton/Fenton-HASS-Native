{
  "Simulator Target Bundle": "com.sfenton.home",
  "aps": {
    "alert": { "title": "Garage Door", "body": "The garage door is open and nobody is home." },
    "sound": "default",
    "interruption-level": "time-sensitive",
    "thread-id": "garage",
    "category": "fenton.dynamic",
    "mutable-content": 1
  },
  "fenton": {
    "v": 1,
    "tag": "garage-open",
    "group": "garage",
    "url": "/sfenton-react-dash/home?path=garage",
    "actions": [
      { "action": "CLOSE_GARAGE", "title": "Close", "icon": "sfsymbols:door.garage.closed", "authenticationRequired": true },
      { "action": "OPEN_GARAGE_PAGE", "title": "Show Garage", "uri": "/sfenton-react-dash/home?path=garage", "icon": "sfsymbols:arrow.up.forward.app" },
      { "action": "REPLY", "title": "Reply", "behavior": "textInput", "textInputButtonTitle": "Send", "textInputPlaceholder": "Note for the house" },
      { "action": "IGNORE_GARAGE", "title": "Ignore", "destructive": true }
    ]
  }
}
